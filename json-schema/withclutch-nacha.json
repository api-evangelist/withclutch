      "type": [
        "string",
        "null"
      ],
      "description": "String: partner identifier UUID."
    },
    "PARTNER_ALIAS": {
      "type": [
        "string",
        "null"
      ],
      "description": "String: partner alias."
    },
    "NACHA_DOCUMENT_ID": {
      "type": [
        "string",
        "null"
      ],
      "description": "String: document identifier UUID."
    },
    "NACHA_FILE_NAME": {
      "type": [
        "string",
        "null"
      ],
